
* { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
}

body { 
    background: #0f172a; 
    color: #cbd5e1; 
    line-height: 1.8; 
    scroll-behavior: smooth; 
}

.container { 
    max-width: 900px; 
    margin: 0 auto; 
    padding: 0 20px; 
}

/* HEADER & NAV */
header { 
    background: #0f172a; 
    border-bottom: 1px solid #1e293b; 
    padding: 20px 0; 
    position: sticky; 
    top: 0; 
    z-index: 100; 
}

.nav-wrap { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
}

.logo { 
    font-size: 1.3rem; 
    font-weight: bold; 
    color: #38bdf8; 
    text-decoration: none; 
}

nav a { 
    color: #94a3b8; 
    text-decoration: none; 
    margin-left: 20px; 
    font-size: 0.9rem; 
    font-weight: 500; 
    transition: color 0.3s; 
}

nav a:hover { 
    color: #38bdf8; 
}

/* SECTIONS GENERAL */
section { 
    padding: 70px 0; 
    border-bottom: 1px solid #1e293b; 
}

h2 { 
    font-size: 1.8rem; 
    color: #ffffff; 
    margin-bottom: 20px; 
}

p { 
    margin-bottom: 15px; 
    font-size: 1rem; 
    color: #94a3b8; 
}

/* HOME (HERO) */
.home { 
    text-align: center; 
    padding-top: 90px; 
}

.home h1 { 
    font-size: 2.4rem; 
    color: #ffffff; 
    margin-bottom: 20px; 
    line-height: 1.3; 
}

.home-img { 
    width: 100%; 
    max-height: 380px; 
    object-fit: cover; 
    border-radius: 8px; 
    margin: 30px 0; 
    border: 1px solid #334155; 
}

/* ABOUT */
.about-content { 
    display: flex; 
    flex-direction: column; 
    gap: 15px; 
}

/* SERVICE */
.service-list { 
    display: flex; 
    flex-direction: column; 
    gap: 25px; 
    margin-top: 30px; 
}

.service-item { 
    background: #1e293b; 
    padding: 25px; 
    border-radius: 8px; 
    border-left: 4px solid #38bdf8; 
}

.service-item h3 { 
    color: #ffffff; 
    margin-bottom: 10px; 
    font-size: 1.2rem; 
}

.service-item p { 
    margin-bottom: 0; 
}

/* CONTACT */
.contact { 
    text-align: center; 
}

.btn { 
    display: inline-block; 
    background: #06b6d4; 
    color: #0f172a; 
    padding: 12px 25px; 
    text-decoration: none; 
    font-weight: bold; 
    border-radius: 5px; 
    margin-top: 15px; 
    transition: background 0.3s; 
}

.btn:hover { 
    background: #22d3ee; 
}

/* FOOTER */
footer { 
    text-align: center; 
    padding: 30px 0; 
    color: #64748b; 
    font-size: 0.85rem; 
}
